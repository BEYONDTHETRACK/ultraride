{
  "appId": "eu.ultraride.app",
  "appName": "UltraRide",
  "webDir": "dist",
  "backgroundColor": "#F5F1E6",
  "plugins": {
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#F5F1E6",
      "showSpinner": false,
      "iosSpinnerStyle": "small",
      "splashFullScreen": false,
      "splashImmersive": false
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
